{
  "uid": "jobtrack-compose",
  "title": "JobTrack Compose monitoring",
  "tags": [
    "JobTrack",
    "JT-93"
  ],
  "schemaVersion": 41,
  "version": 2,
  "editable": false,
  "timezone": "browser",
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "jobtrack-prometheus"
        },
        "query": "label_values(up{job=\"jobtrack\"}, service)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by service",
      "description": "Completed requests per second. Gateway HTTP and service unary gRPC are separate hops; do not sum across services. Health, metrics and gRPC health are excluded.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "jobtrack-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(jobtrack_requests_total{job=\"jobtrack\",service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate by service",
      "description": "Fraction of completed requests with HTTP status >=400 or non-OK gRPC code, including expected validation/authentication failures. Zero with traffic and no errors; gaps with no traffic or insufficient samples.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "jobtrack-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum by (service) (rate(jobtrack_requests_total{job=\"jobtrack\",service=~\"$service\",result=\"error\"}[$__rate_interval]))) or on (service) (0 * (sum by (service) (rate(jobtrack_requests_total{job=\"jobtrack\",service=~\"$service\"}[$__rate_interval]))))) / on (service) ((sum by (service) (rate(jobtrack_requests_total{job=\"jobtrack\",service=~\"$service\"}[$__rate_interval]))) > 0)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Mean request latency by service",
      "description": "Mean observed request duration in seconds across methods and results, weighted by request count. Gaps with no traffic or insufficient samples; no synthetic zero latency.",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "jobtrack-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (service) (rate(jobtrack_request_duration_seconds_sum{job=\"jobtrack\",service=~\"$service\"}[$__rate_interval]))) / on (service) ((sum by (service) (rate(jobtrack_request_duration_seconds_count{job=\"jobtrack\",service=~\"$service\"}[$__rate_interval]))) > 0)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Scrape availability by service",
      "description": "1 = scrape succeeded, 0 = scrape failed. Does not prove business readiness.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "jobtrack-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"jobtrack\",service=~\"$service\"}",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Readiness by service",
      "description": "Existing service readiness gauge: 1 = ready, 0 = not ready. Missing data means no sample; gateway readiness only indicates it is serving.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "jobtrack-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jobtrack_service_ready{job=\"jobtrack\",service=~\"$service\"}",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Metrics scrape duration by service",
      "description": "Prometheus scrape duration, including the endpoint readiness check. This does not measure application request latency.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "jobtrack-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "scrape_duration_seconds{job=\"jobtrack\",service=~\"$service\"}",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ]
}
