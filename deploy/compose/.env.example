# Copy this file to .env in the same folder and replace the placeholder values.
# .env is ignored by Git. Never commit real passwords.

# PostgreSQL superuser, used only by the init script.
POSTGRES_PASSWORD=change-me

# Password for every per-service database user (local development only).
SERVICE_DB_PASSWORD=change-me

# RabbitMQ login used by all services.
RABBITMQ_USER=jobtrack
RABBITMQ_PASSWORD=change-me

# Signs and verifies JWTs (auth and gateway only). Must be at least 32 bytes;
# auth refuses to start with this placeholder. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=change-me

# Seeded admin (placement coordinator), created once by auth at startup.
# auth refuses to start if ADMIN_PASSWORD is change-me or shorter than 12 characters.
ADMIN_EMAIL=admin@jobtrack.test
ADMIN_PASSWORD=change-me
