# Copy this file to .env in the same folder and replace the placeholder values.
# .env is ignored by Git. Never commit real passwords.

# PostgreSQL superuser, used only by the init script.
POSTGRES_PASSWORD=change-me

# Password for every per-service database user (local development only).
SERVICE_DB_PASSWORD=change-me

# RabbitMQ login used by all services.
RABBITMQ_USER=jobtrack
RABBITMQ_PASSWORD=change-me
